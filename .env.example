# Copy to .env and fill in as needed. Never commit the real .env file.

# --- LLM supervisor (only one needed, matching config/system.yaml supervisor.provider) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Config file overrides (optional; relative to the repository root) ---
ROBOTS_CONFIG_PATH=./config/robots.yaml
MISSION_CONFIG_PATH=./config/mission.yaml
SYSTEM_CONFIG_PATH=./config/system.yaml

# --- Deployment mode: SIMULATION | TEST | PHYSICAL ---
# SIMULATION uses MockDroneAdapter/MockTurtleBotAdapter and enables fault
# injection endpoints. PHYSICAL disables fault injection outright.
DEPLOYMENT_MODE=SIMULATION
